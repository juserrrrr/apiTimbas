generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DiscordServer {
  id                Int                 @id @default(autoincrement())
  discordServerId   String              @unique
  doorMessageId     Int?                @unique
  doorMessages      DoorMessages?       @relation(fields: [doorMessageId], references: [id])
  dateCreated       DateTime            @default(now())
  dateUpdated       DateTime            @updatedAt
  CustomLeagueMatch CustomLeagueMatch[]

  @@index([discordServerId])
}

model DoorMessages {
  id               Int            @id @default(autoincrement())
  welcomeMsg       Message?       @relation("WelcomeMessage", fields: [welcomeMessageId], references: [id])
  welcomeMessageId Int?           @unique
  goodbyeMsg       Message?       @relation("GoodbyeMessage", fields: [goodbyeMessageId], references: [id])
  goodbyeMessageId Int?           @unique
  banMsg           Message?       @relation("BanMessage", fields: [banMessageId], references: [id])
  banMessageId     Int?           @unique
  channelId        String?
  DiscordServer    DiscordServer?
}

model Message {
  id           Int           @id @default(autoincrement())
  isEmbed      Boolean       @default(false)
  content      String?
  embed        Embed?
  messageType  MessageType   @default(WELCOME)
  asWelcomeMsg DoorMessages? @relation("WelcomeMessage")
  asGoodbyeMsg DoorMessages? @relation("GoodbyeMessage")
  asBanMsg     DoorMessages? @relation("BanMessage")
}

enum MessageType {
  WELCOME
  GOODBYE
  BAN
}

model Embed {
  id          Int             @id @default(autoincrement())
  title       String?
  description String?
  color       String?
  url         String?
  timestamp   Boolean?        @default(false)
  footer      EmbedFooter?
  image       EmbedImage?
  thumbnail   EmbedThumbnail?
  author      EmbedAuthor?
  fields      EmbedField[]
  message     Message         @relation(fields: [messageId], references: [id])
  messageId   Int             @unique
}

model EmbedFooter {
  id      Int     @id @default(autoincrement())
  text    String?
  iconUrl String?
  embed   Embed   @relation(fields: [embedId], references: [id])
  embedId Int     @unique
}

model EmbedImage {
  id      Int     @id @default(autoincrement())
  url     String?
  height  Int?
  width   Int?
  embed   Embed   @relation(fields: [embedId], references: [id])
  embedId Int     @unique
}

model EmbedThumbnail {
  id      Int     @id @default(autoincrement())
  url     String?
  height  Int?
  width   Int?
  embed   Embed   @relation(fields: [embedId], references: [id])
  embedId Int     @unique
}

model EmbedAuthor {
  id      Int     @id @default(autoincrement())
  name    String?
  url     String?
  iconUrl String?
  embed   Embed   @relation(fields: [embedId], references: [id])
  embedId Int     @unique
}

model EmbedField {
  id      Int      @id @default(autoincrement())
  name    String
  value   String
  inline  Boolean? @default(false)
  embed   Embed    @relation(fields: [embedId], references: [id])
  embedId Int
}

enum Role {
  ADMIN
  BOT
  USER
  PLAYER
}

/// Porta de entrada da plataforma. PENDING só existe quando a aprovação está
/// ligada nas configurações; sem isso todo mundo entra aprovado.
enum UserStatus {
  PENDING
  APPROVED
  BLOCKED
}

model User {
  id                     Int                      @id @default(autoincrement())
  discordId              String                   @unique
  name                   String
  email                  String?                  @unique
  password               String?
  role                   Role                     @default(PLAYER)
  avatar                 String?
  lastLoginIp            String?
  lastLoginAt            DateTime?
  dateOfBirth            DateTime?
  dateCreated            DateTime                 @default(now())
  dateUpdated            DateTime                 @updatedAt
  TeamsLeague            UserTeamLeague[]
  leagueAccounts         LeagueAccount[]
  tournamentTeams        TournamentTeamMember[]
  tournamentStaff        TournamentStaff[]
  wallet                 Wallet?
  draftRosters           DraftRoster[]
  draftStaff             DraftStaff[]
  status                 UserStatus               @default(APPROVED)
  statusNote             String?
  reviewedByUserId       Int?
  reviewedAt             DateTime?
  groups                 UserGroupMember[]
  TournamentMatchMessage TournamentMatchMessage[]

  @@index([status])
}

/// Cargo dinâmico: o admin monta o grupo e marca as permissões pelo painel. ADMIN
/// da plataforma não depende de grupo nenhum, ele já tem tudo.
model PermissionGroup {
  id          String            @id @default(cuid())
  name        String            @unique
  description String?
  permissions String[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  members     UserGroupMember[]
}

model UserGroupMember {
  id        String          @id @default(cuid())
  userId    Int
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId   String
  group     PermissionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  @@unique([userId, groupId])
  @@index([groupId])
}

/// Linha única (id=1) com as chaves da porta de entrada.
model PlatformSettings {
  id                 Int      @id @default(1)
  requireApproval    Boolean  @default(false)
  approvalMessage    String?
  updatedByDiscordId String?
  updatedAt          DateTime @updatedAt
}

model LeagueAccount {
  id        Int      @id @default(autoincrement())
  puuid     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum Side {
  BLUE
  RED
}

enum MatchType {
  ALEATORIO
  LIVRE
  BALANCEADO
  ALEATORIO_COMPLETO
}

enum Position {
  TOP
  JUNGLE
  MID
  ADC
  SUPPORT
}

enum MatchStatus {
  WAITING
  STARTED
  FINISHED
  EXPIRED
}

/// Modo de jogo da partida personalizada.
/// Cada modo já implica o seu mapa, por isso não existe coluna de mapa
/// separada: guardar os dois permitiria estados impossíveis como "ARAM no
/// Summoner's Rift". O nome do mapa é derivado na exibição (ver
/// GAME_MODE_MAP_NAMES no backend).
///
/// SUMMONERS_RIFT = Summoner's Rift atual
/// LOL_CLASSIC    = League Classic, o Summoner's Rift Classic (lançado em 2026-07-29)
/// ARAM           = Howling Abyss
enum GameMode {
  SUMMONERS_RIFT
  LOL_CLASSIC
  ARAM
}

model TeamLeague {
  id                  Int                @id @default(autoincrement())
  side                Side
  players             UserTeamLeague[]
  customLeagueMatchId Int?
  CustomLeagueMatch   CustomLeagueMatch? @relation(fields: [customLeagueMatchId], references: [id])

  @@index([side])
  @@index([customLeagueMatchId])
}

model UserTeamLeague {
  id           Int                @id @default(autoincrement())
  userId       Int
  user         User               @relation(fields: [userId], references: [id])
  teamLeagueId Int?
  teamLeague   TeamLeague?        @relation(fields: [teamLeagueId], references: [id])
  matchId      Int?
  match        CustomLeagueMatch? @relation("MatchQueue", fields: [matchId], references: [id])
  position     Position?

  @@unique([userId, matchId])
  @@unique([userId, teamLeagueId])
  @@index([userId])
  @@index([teamLeagueId])
  @@index([matchId])
}

model CustomLeagueMatch {
  id               Int              @id @default(autoincrement())
  riotMatchId      String?          @unique
  matchType        MatchType        @default(ALEATORIO)
  gameMode         GameMode         @default(SUMMONERS_RIFT)
  playersPerTeam   Int              @default(5)
  teamBlueId       Int?
  teamRedId        Int?
  winnerId         Int?
  mvpUserId        Int?
  ServerDiscordId  String
  discordServer    DiscordServer    @relation(fields: [ServerDiscordId], references: [discordServerId])
  Teams            TeamLeague[]
  status           MatchStatus      @default(FINISHED)
  creatorDiscordId String?
  discordChannelId String?
  discordMessageId String?
  showDetails      Boolean          @default(false)
  queuePlayers     UserTeamLeague[] @relation("MatchQueue")
  startedAt        DateTime?
  finishedAt       DateTime?
  expiresAt        DateTime?
  dateCreated      DateTime         @default(now())
  dateUpdated      DateTime         @updatedAt

  @@index([winnerId])
  @@index([ServerDiscordId])
  @@index([matchType])
  @@index([gameMode])
  @@index([playersPerTeam])
  @@index([status])
  @@index([creatorDiscordId])
  @@index([discordMessageId])
  @@index([ServerDiscordId, status])
  @@index([ServerDiscordId, winnerId])
  @@index([ServerDiscordId, gameMode])
}

model VerifiedAccount {
  id         String   @id @default(cuid())
  discordId  String   @unique
  puuid      String   @unique
  riotId     String
  summonerId String
  verifiedAt DateTime @default(now())
  iconId     Int
}

model PendingVerification {
  id           String   @id @default(cuid())
  discordId    String
  puuid        String
  summonerId   String
  riotId       String
  targetIconId Int
  expiresAt    DateTime
  attempts     Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([discordId])
}

model ClashAnalysis {
  id        String   @id @default(cuid())
  teamName  String
  data      Json
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Season {
  id        Int       @id @default(autoincrement())
  serverId  String
  number    Int
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  champions Json?

  @@unique([serverId, number])
  @@index([serverId, endedAt])
}

model Achievement {
  id         Int      @id @default(autoincrement())
  serverId   String
  userId     Int
  type       String
  unlockedAt DateTime @default(now())

  @@unique([serverId, userId, type])
  @@index([serverId, userId])
}

enum EaClubMatchResult {
  WIN
  DRAW
  LOSS
}

model EaClub {
  id               String         @id @default(cuid())
  externalClubId   String
  name             String
  platform         String
  nickname         String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  lastSyncAt       DateTime?
  eaStatsUpdatedAt DateTime?
  eaGamesPlayed    Int?
  eaWins           Int?
  eaDraws          Int?
  eaLosses         Int?
  eaGoalsFor       Int?
  eaGoalsAgainst   Int?
  matches          EaClubMatch[]
  players          EaClubPlayer[]

  @@unique([externalClubId, platform])
  @@index([name])
}

model EaClubMatch {
  id                 String              @id @default(cuid())
  externalMatchId    String
  clubId             String
  club               EaClub              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  playedAt           DateTime
  isHome             Boolean
  opponentExternalId String
  opponentName       String
  goalsFor           Int
  goalsAgainst       Int
  result             EaClubMatchResult
  rawData            Json?
  createdAt          DateTime            @default(now())
  playerStats        EaMatchPlayerStat[]

  @@unique([clubId, externalMatchId])
  @@index([clubId, playedAt])
  @@index([clubId, result, playedAt])
  @@index([clubId, opponentName])
}

model EaClubPlayer {
  id                      String              @id @default(cuid())
  clubId                  String
  club                    EaClub              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  externalPlayerId        String?
  identityKey             String
  playerName              String
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  careerGames             Int?
  careerGoals             Int?
  careerAssists           Int?
  careerMvps              Int?
  careerRating            Float?
  careerStatsUpdatedAt    DateTime?
  eaClubGames             Int?
  eaClubGoals             Int?
  eaClubAssists           Int?
  eaClubMvps              Int?
  eaClubRating            Float?
  eaClubPassesMade        Int?
  eaClubPassSuccessRate   Float?
  eaClubTacklesMade       Int?
  eaClubTackleSuccessRate Float?
  eaClubShotSuccessRate   Float?
  eaClubCleanSheetsDef    Int?
  eaClubCleanSheetsGk     Int?
  eaClubRedCards          Int?
  eaClubStatsUpdatedAt    DateTime?
  matchStats              EaMatchPlayerStat[]

  @@unique([clubId, identityKey])
  @@index([clubId, playerName])
  @@index([clubId, externalPlayerId])
}

model EaMatchPlayerStat {
  matchId          String
  match            EaClubMatch  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId         String
  player           EaClubPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)
  position         String?
  rating           Float?
  goals            Int          @default(0)
  assists          Int          @default(0)
  shots            Int?
  passesAttempted  Int?
  passesCompleted  Int?
  tacklesAttempted Int?
  tacklesCompleted Int?
  saves            Int?
  manOfTheMatch    Boolean?

  @@id([matchId, playerId])
  @@index([playerId, matchId])
  @@index([matchId])
}

// ─── Competições ──────────────────────────────────────────────────────────────
// O módulo de torneios é agnóstico de jogo: `game` só define rótulos e ícones na
// UI. As regras (chaveamento, pontuação, prova por foto) valem para qualquer
// título — EA FC é apenas o default.

enum CompetitionGame {
  EA_FC
  LOL
  VALORANT
  CS
  ROCKET_LEAGUE
  OTHER
}

enum TournamentFormat {
  SINGLE_ELIMINATION
  DOUBLE_ELIMINATION
  ROUND_ROBIN
  GROUPS_KNOCKOUT
}

enum TournamentStatus {
  DRAFT
  REGISTRATION
  RUNNING
  FINISHED
  CANCELLED
}

enum TournamentPhase {
  GROUP
  LEAGUE
  WINNERS
  LOSERS
  GRAND_FINAL
  THIRD_PLACE
}

enum TournamentMatchStatus {
  PENDING
  READY
  AWAITING_PROOF
  DISPUTED
  FINISHED
  WALKOVER
}

enum MatchSlot {
  HOME
  AWAY
}

enum CompetitionRole {
  OWNER
  MODERATOR
}

model Tournament {
  id                       String            @id @default(cuid())
  name                     String
  slug                     String            @unique
  description              String?
  game                     CompetitionGame   @default(EA_FC)
  gameLabel                String?
  format                   TournamentFormat  @default(SINGLE_ELIMINATION)
  status                   TournamentStatus  @default(DRAFT)
  maxTeams                 Int               @default(8)
  teamSize                 Int               @default(1)
  groupCount               Int               @default(2)
  advancePerGroup          Int               @default(2)
  legs                     Int               @default(1)
  thirdPlace               Boolean           @default(false)
  allowDraws               Boolean           @default(true)
  pointsWin                Int               @default(3)
  pointsDraw               Int               @default(1)
  pointsLoss               Int               @default(0)
  coinsWin                 Int               @default(50)
  coinsDraw                Int               @default(20)
  coinsLoss                Int               @default(5)
  coinsChampion            Int               @default(500)
  coinsRunnerUp            Int               @default(200)
  requireProof             Boolean           @default(true)
  // Confirmação do adversário: um time informa o placar e o outro confirma. Sem
  // resposta até o prazo, quem não apareceu perde por W.O.
  requireOpponentConfirm   Boolean           @default(true)
  woAfterHours             Int               @default(72)
  autoApproveProof         Boolean           @default(true)
  autoApproveMinConfidence Int               @default(80)
  registrationEndsAt       DateTime?
  autoStartOnClose         Boolean           @default(false)
  createdByDiscordId       String
  bannerUrl                String?
  startsAt                 DateTime?
  finishedAt               DateTime?
  championTeamId           String?
  runnerUpTeamId           String?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  teams                    TournamentTeam[]
  groups                   TournamentGroup[]
  matches                  TournamentMatch[]
  staff                    TournamentStaff[]

  @@index([status])
  @@index([game])
  @@index([status, startsAt])
  @@index([status, registrationEndsAt])
}

model TournamentStaff {
  id            String          @id @default(cuid())
  tournamentId  String
  tournament    Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId        Int
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          CompetitionRole @default(MODERATOR)
  addedByUserId Int?
  createdAt     DateTime        @default(now())

  @@unique([tournamentId, userId])
  @@index([userId])
  @@index([tournamentId, role])
}

model TournamentTeam {
  id             String                 @id @default(cuid())
  tournamentId   String
  tournament     Tournament             @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name           String
  tag            String?
  logoUrl        String?
  seed           Int?
  groupId        String?
  group          TournamentGroup?       @relation(fields: [groupId], references: [id])
  ownerDiscordId String?
  eaClubId       String?
  eliminated     Boolean                @default(false)
  played         Int                    @default(0)
  wins           Int                    @default(0)
  draws          Int                    @default(0)
  losses         Int                    @default(0)
  scoreFor       Int                    @default(0)
  scoreAgainst   Int                    @default(0)
  points         Int                    @default(0)
  createdAt      DateTime               @default(now())
  members        TournamentTeamMember[]
  homeMatches    TournamentMatch[]      @relation("TournamentHome")
  awayMatches    TournamentMatch[]      @relation("TournamentAway")

  @@unique([tournamentId, name])
  @@index([tournamentId, groupId])
  @@index([ownerDiscordId])
}

model TournamentTeamMember {
  id      String         @id @default(cuid())
  teamId  String
  team    TournamentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId  Int
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  captain Boolean        @default(false)

  @@unique([teamId, userId])
  @@index([userId])
}

model TournamentGroup {
  id           String            @id @default(cuid())
  tournamentId String
  tournament   Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name         String
  order        Int
  teams        TournamentTeam[]
  matches      TournamentMatch[]

  @@unique([tournamentId, order])
}

model TournamentMatch {
  id                       String                   @id @default(cuid())
  tournamentId             String
  tournament               Tournament               @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  groupId                  String?
  group                    TournamentGroup?         @relation(fields: [groupId], references: [id])
  phase                    TournamentPhase          @default(WINNERS)
  round                    Int                      @default(1)
  position                 Int                      @default(0)
  leg                      Int                      @default(1)
  label                    String?
  homeTeamId               String?
  homeTeam                 TournamentTeam?          @relation("TournamentHome", fields: [homeTeamId], references: [id])
  awayTeamId               String?
  awayTeam                 TournamentTeam?          @relation("TournamentAway", fields: [awayTeamId], references: [id])
  homeScore                Int?
  awayScore                Int?
  winnerTeamId             String?
  status                   TournamentMatchStatus    @default(PENDING)
  readyAt                  DateTime?
  scheduledAt              DateTime?
  scheduleProposedAt       DateTime?
  scheduleProposedByTeamId String?
  claimedHomeScore         Int?
  claimedAwayScore         Int?
  claimedByTeamId          String?
  claimedAt                DateTime?
  playedAt                 DateTime?
  reportedByDiscordId      String?
  nextMatchId              String?
  nextMatch                TournamentMatch?         @relation("BracketAdvance", fields: [nextMatchId], references: [id])
  nextMatchSlot            MatchSlot?
  loserNextMatchId         String?
  loserNextMatch           TournamentMatch?         @relation("BracketDrop", fields: [loserNextMatchId], references: [id])
  loserNextMatchSlot       MatchSlot?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  feedsInto                TournamentMatch[]        @relation("BracketAdvance")
  dropsInto                TournamentMatch[]        @relation("BracketDrop")
  proofs                   MatchProof[]
  messages                 TournamentMatchMessage[]

  @@unique([tournamentId, phase, round, position, leg])
  @@index([tournamentId, status])
  @@index([tournamentId, phase, round])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([scheduledAt])
}

/// Conversa da partida: os dois times combinam horário e resolvem pendência aqui.
/// Mensagem de sistema registra proposta, placar informado e W.O., para a decisão
/// ficar com histórico.
model TournamentMatchMessage {
  id        String          @id @default(cuid())
  matchId   String
  match     TournamentMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId    Int?
  user      User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  teamId    String?
  body      String
  system    Boolean         @default(false)
  createdAt DateTime        @default(now())

  @@index([matchId, createdAt])
}

// ─── Prova de resultado por foto ──────────────────────────────────────────────

enum MatchProofStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AiProvider {
  GEMINI
  DEEPSEEK
  OPENAI
}

enum ScoreReadMode {
  VISION
  OCR_TEXT
}

model AiSettings {
  id                    Int           @id @default(1)
  analysisEnabled       Boolean       @default(true)
  analysisProvider      AiProvider    @default(GEMINI)
  analysisModel         String?
  analysisFallbackModel String?
  scoreReaderEnabled    Boolean       @default(false)
  scoreReaderProvider   AiProvider    @default(OPENAI)
  scoreReaderModel      String?
  scoreReadMode         ScoreReadMode @default(VISION)
  ocrLanguage           String        @default("por")
  timeoutMs             Int           @default(45000)
  maxImageBytes         Int           @default(4194304)
  lastCheckedAt         DateTime?
  lastCheckOk           Boolean?
  lastCheckMessage      String?
  updatedByDiscordId    String?
  updatedAt             DateTime      @updatedAt
}

enum CatalogSource {
  MANUAL
  FOOTBALL_DATA
  GENERIC
}

model CatalogCompetition {
  id                String              @id @default(cuid())
  code              String              @unique
  name              String
  country           String?
  source            CatalogSource       @default(MANUAL)
  sourcePath        String?
  lastSyncAt        DateTime?
  lastSyncOk        Boolean?
  lastSyncMessage   String?
  // Rodadas de mentira que mantêm a base viva. Uma vez por dia no máximo.
  simulationEnabled Boolean             @default(true)
  worldRound        Int                 @default(0)
  lastWorldTickAt   DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  teams             CatalogTeam[]
  draftSources      DraftLeagueSource[]
}

model CatalogTeam {
  id            String             @id @default(cuid())
  competitionId String
  competition   CatalogCompetition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  externalId    String?
  name          String
  shortName     String?
  crestUrl      String?
  source        CatalogSource      @default(MANUAL)
  syncedAt      DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  players       CatalogPlayer[]

  @@unique([competitionId, name])
  @@index([competitionId])
}

model CatalogPlayer {
  id              String        @id @default(cuid())
  teamId          String
  team            CatalogTeam   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  externalId      String?
  name            String
  position        String
  overall         Int           @default(70)
  nationality     String?
  birthDate       DateTime?
  photoUrl        String?
  price           Int           @default(500000)
  active          Boolean       @default(true)
  source          CatalogSource @default(MANUAL)
  syncedAt        DateTime?
  // Os seis atributos do card, na ordem do EA FC. Para goleiro as mesmas colunas
  // valem elasticidade, manejo, chute, reflexos, velocidade e posicionamento,
  // como no card do jogo. Nulo quando ninguém estimou ainda.
  pace            Int?
  shooting        Int?
  passing         Int?
  dribbling       Int?
  defending       Int?
  physical        Int?
  attributesModel String?
  attributesNote  String?
  attributesAt    DateTime?
  // Vida do jogador fora das nossas ligas: ele segue jogando na competição dele,
  // ganha nota por partida, oscila de forma e evolui ou cai com o tempo.
  form            Int           @default(0)
  matchesPlayed   Int           @default(0)
  ratingAvg       Float?
  lastRating      Float?
  lastPlayedAt    DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  draftCopies     DraftPlayer[]

  @@unique([teamId, name])
  @@index([teamId, position])
  @@index([name])
}

model MatchProof {
  id                   String           @id @default(cuid())
  matchId              String?
  match                TournamentMatch? @relation(fields: [matchId], references: [id], onDelete: Cascade)
  draftMatchId         String?
  draftMatch           DraftMatch?      @relation(fields: [draftMatchId], references: [id], onDelete: Cascade)
  submittedByDiscordId String
  image                Bytes
  mimeType             String
  claimedHomeScore     Int
  claimedAwayScore     Int
  aiProvider           String?
  aiModel              String?
  aiHomeScore          Int?
  aiAwayScore          Int?
  aiConfidence         Int?
  aiAgrees             Boolean?
  aiNotes              String?
  aiRaw                Json?
  status               MatchProofStatus @default(PENDING)
  reviewedByDiscordId  String?
  reviewedAt           DateTime?
  reviewNote           String?
  createdAt            DateTime         @default(now())

  @@index([matchId, status])
  @@index([draftMatchId, status])
  @@index([status, createdAt])
}

// ─── Economia (moedas) ────────────────────────────────────────────────────────

enum WalletTxType {
  MATCH_WIN
  MATCH_DRAW
  MATCH_LOSS
  TOURNAMENT_PRIZE
  DRAFT_SALE
  DRAFT_PURCHASE
  TRANSFER_IN
  TRANSFER_OUT
  ADMIN_ADJUST
}

model Wallet {
  id           Int                 @id @default(autoincrement())
  userId       Int                 @unique
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance      Int                 @default(0)
  totalEarned  Int                 @default(0)
  totalSpent   Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  transactions WalletTransaction[]

  @@index([balance])
}

model WalletTransaction {
  id            String       @id @default(cuid())
  walletId      Int
  wallet        Wallet       @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount        Int
  balanceAfter  Int
  type          WalletTxType
  description   String
  referenceType String?
  referenceId   String?
  createdAt     DateTime     @default(now())

  @@index([walletId, createdAt])
  @@index([referenceType, referenceId])
}

// ─── Liga de draft ────────────────────────────────────────────────────────────

enum DraftLeagueStatus {
  SETUP
  DRAFTING
  ACTIVE
  FINISHED
}

enum DraftOrderType {
  SNAKE
  LINEAR
}

/// LIVE: todo mundo marca presença e o draft só abre quando os donos estão
/// prontos, porque escolher junto é metade da graça.
/// ASYNC: o dono abre quando quiser e quem não aparecer é escolhido pelo relógio.
enum DraftStartMode {
  LIVE
  ASYNC
}

/// REPORTED: o placar vem de quem jogou, com prova por foto.
/// SIMULATED: o job da rodada joga a partida com atributos, forma e tática.
enum DraftResultMode {
  REPORTED
  SIMULATED
}

enum TacticMentality {
  DEFENSIVE
  BALANCED
  ATTACKING
}

enum TacticIntensity {
  LOW
  MEDIUM
  HIGH
}

/// De onde vem e para onde vai o dinheiro do elenco dentro da liga.
enum DraftBudgetTxType {
  SEED
  MATCH_REWARD
  SALARY
  SIGNING
  SALE
  TRANSFER_IN
  TRANSFER_OUT
  AUCTION_BID
  AUCTION_REFUND
  AUCTION_SALE
  ADJUST
}

enum AuctionStatus {
  OPEN
  SOLD
  EXPIRED
  CANCELLED
}

enum DraftMatchStatus {
  SCHEDULED
  AWAITING_PROOF
  FINISHED
}

enum TransferOfferKind {
  BUY_FREE_AGENT
  BUY_FROM_ROSTER
  SWAP
}

enum TransferOfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
}

model DraftLeague {
  id                         String              @id @default(cuid())
  name                       String
  description                String?
  status                     DraftLeagueStatus   @default(SETUP)
  orderType                  DraftOrderType      @default(SNAKE)
  startMode                  DraftStartMode      @default(LIVE)
  draftStartsAt              DateTime?
  rosterSize                 Int                 @default(25)
  formation                  String              @default("4-3-3")
  pickSeconds                Int                 @default(120)
  matchDays                  Int[]               @default([0, 3])
  matchHour                  Int                 @default(21)
  totalRounds                Int                 @default(0)
  currentRound               Int                 @default(0)
  currentPickNumber          Int                 @default(0)
  pickDeadline               DateTime?
  pointsWin                  Int                 @default(3)
  pointsDraw                 Int                 @default(1)
  // O dinheiro é da liga, não da conta: cada elenco começa com este caixa, que
  // nasce de novo a cada draft. Premiação de rodada e salário mexem nele.
  startingBudget             Int                 @default(200000000)
  paySalaries                Boolean             @default(true)
  // Leilão: lance aberto, prazo em horas, incremento mínimo em porcentagem do
  // lance atual e prorrogação quando alguém dá lance no fim, para não virar
  // corrida de último segundo.
  auctionsEnabled            Boolean             @default(true)
  auctionHours               Int                 @default(24)
  auctionMinIncrementPercent Int                 @default(5)
  auctionAntiSnipeMinutes    Int                 @default(5)
  coinsWin                   Int                 @default(3000000)
  coinsDraw                  Int                 @default(1000000)
  coinsLoss                  Int                 @default(400000)
  resultMode                 DraftResultMode     @default(REPORTED)
  transferWindowOpen         Boolean             @default(true)
  // O mercado fecha esse tanto de minutos antes do horário da rodada e reabre
  // quando a rodada inteira termina.
  marketClosesMinutesBefore  Int                 @default(180)
  marketAutoManaged          Boolean             @default(true)
  registrationEndsAt         DateTime?
  autoStartOnClose           Boolean             @default(false)
  createdByDiscordId         String
  startedAt                  DateTime?
  finishedAt                 DateTime?
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
  players                    DraftPlayer[]
  rosters                    DraftRoster[]
  picks                      DraftPick[]
  matches                    DraftMatch[]
  offers                     TransferOffer[]
  staff                      DraftStaff[]
  sources                    DraftLeagueSource[]
  budgetEntries              DraftBudgetEntry[]
  auctions                   DraftAuction[]

  @@index([status])
  @@index([status, registrationEndsAt])
  @@index([status, resultMode])
}

/// Competições da base que a liga aceita. Vazio significa só o que já está no
/// pool: sem essa lista ninguém contrata de fora.
model DraftLeagueSource {
  id            String             @id @default(cuid())
  leagueId      String
  league        DraftLeague        @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  competitionId String
  competition   CatalogCompetition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  createdAt     DateTime           @default(now())

  @@unique([leagueId, competitionId])
  @@index([competitionId])
}

model DraftStaff {
  id            String          @id @default(cuid())
  leagueId      String
  league        DraftLeague     @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  userId        Int
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          CompetitionRole @default(MODERATOR)
  addedByUserId Int?
  createdAt     DateTime        @default(now())

  @@unique([leagueId, userId])
  @@index([userId])
  @@index([leagueId, role])
}

model DraftPlayer {
  id              String          @id @default(cuid())
  leagueId        String
  league          DraftLeague     @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  // Cópia da base global feita no import. O vínculo é só rastreio: a base pode
  // mudar depois sem reescrever liga em andamento.
  catalogPlayerId String?
  catalogPlayer   CatalogPlayer?  @relation(fields: [catalogPlayerId], references: [id], onDelete: SetNull)
  name            String
  position        String
  overall         Int             @default(70)
  realTeam        String?
  nationality     String?
  birthDate       DateTime?
  photoUrl        String?
  price           Int             @default(500000)
  pace            Int?
  shooting        Int?
  passing         Int?
  dribbling       Int?
  defending       Int?
  physical        Int?
  rosterId        String?
  roster          DraftRoster?    @relation(fields: [rosterId], references: [id])
  starter         Boolean         @default(false)
  slot            String?
  // Salário cobrado do caixa do elenco a cada rodada.
  salary          Int             @default(0)
  appearances     Int             @default(0)
  goals           Int             @default(0)
  assists         Int             @default(0)
  rating          Float?
  lastRating      Float?
  // Forma recente, de -5 a 5, movida pela nota de cada partida.
  form            Int             @default(0)
  createdAt       DateTime        @default(now())
  picks           DraftPick[]
  offers          TransferOffer[]
  auctions        DraftAuction[]

  @@unique([leagueId, name])
  @@index([leagueId, rosterId])
  @@index([leagueId, position])
  @@index([leagueId, overall])
  @@index([catalogPlayerId])
}

model DraftRoster {
  id              String             @id @default(cuid())
  leagueId        String
  league          DraftLeague        @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  // Time sem dono é vaga aberta: a liga começa mesmo sem gente, esse time perde
  // por W.O. e alguém pode assumir depois.
  userId          Int?
  user            User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  tag             String?
  logoUrl         String?
  formation       String             @default("4-3-3")
  mentality       TacticMentality    @default(BALANCED)
  pressing        TacticIntensity    @default(MEDIUM)
  tempo           TacticIntensity    @default(MEDIUM)
  tacticsAt       DateTime?
  readyAt         DateTime?
  budget          Int                @default(0)
  earned          Int                @default(0)
  spent           Int                @default(0)
  draftOrder      Int                @default(0)
  played          Int                @default(0)
  wins            Int                @default(0)
  draws           Int                @default(0)
  losses          Int                @default(0)
  goalsFor        Int                @default(0)
  goalsAgainst    Int                @default(0)
  points          Int                @default(0)
  createdAt       DateTime           @default(now())
  players         DraftPlayer[]
  picks           DraftPick[]
  homeMatches     DraftMatch[]       @relation("DraftHome")
  awayMatches     DraftMatch[]       @relation("DraftAway")
  offersMade      TransferOffer[]    @relation("TransferFrom")
  offersReceived  TransferOffer[]    @relation("TransferTo")
  budgetEntries   DraftBudgetEntry[]
  auctionsSelling DraftAuction[]     @relation("AuctionSeller")
  auctionsLeading DraftAuction[]     @relation("AuctionLeader")
  auctionBids     DraftAuctionBid[]

  @@unique([leagueId, userId])
  @@unique([leagueId, name])
  @@index([leagueId, points])
}

model DraftPick {
  id         String      @id @default(cuid())
  leagueId   String
  league     DraftLeague @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  rosterId   String
  roster     DraftRoster @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  playerId   String
  player     DraftPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)
  round      Int
  pickNumber Int
  price      Int         @default(0)
  auto       Boolean     @default(false)
  createdAt  DateTime    @default(now())

  @@unique([leagueId, playerId])
  @@unique([leagueId, pickNumber])
  @@index([rosterId])
}

/// Leilão de lance aberto: todo mundo vê o maior lance e quem deu. O dinheiro do
/// líder fica preso até alguém cobrir, o que evita ganhar leilão sem ter caixa.
model DraftAuction {
  id             String            @id @default(cuid())
  leagueId       String
  league         DraftLeague       @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  playerId       String
  player         DraftPlayer       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  // Nulo quando é o pool da liga indo a leilão: aí não há vendedor para receber.
  sellerRosterId String?
  sellerRoster   DraftRoster?      @relation("AuctionSeller", fields: [sellerRosterId], references: [id], onDelete: SetNull)
  startingBid    Int
  currentBid     Int               @default(0)
  bidCount       Int               @default(0)
  leaderRosterId String?
  leaderRoster   DraftRoster?      @relation("AuctionLeader", fields: [leaderRosterId], references: [id], onDelete: SetNull)
  status         AuctionStatus     @default(OPEN)
  endsAt         DateTime
  closedAt       DateTime?
  createdAt      DateTime          @default(now())
  bids           DraftAuctionBid[]

  @@index([leagueId, status])
  @@index([status, endsAt])
  @@index([playerId])
}

model DraftAuctionBid {
  id        String       @id @default(cuid())
  auctionId String
  auction   DraftAuction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  rosterId  String
  roster    DraftRoster  @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  amount    Int
  createdAt DateTime     @default(now())

  @@index([auctionId, createdAt])
  @@index([rosterId])
}

/// Extrato do caixa do elenco na liga. Serve para explicar para onde foi o
/// dinheiro, e morre junto com a liga.
model DraftBudgetEntry {
  id           String            @id @default(cuid())
  leagueId     String
  league       DraftLeague       @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  rosterId     String
  roster       DraftRoster       @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  amount       Int
  balanceAfter Int
  type         DraftBudgetTxType
  description  String
  round        Int?
  createdAt    DateTime          @default(now())

  @@index([rosterId, createdAt])
  @@index([leagueId, createdAt])
}

model DraftMatch {
  id                  String           @id @default(cuid())
  leagueId            String
  league              DraftLeague      @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  round               Int
  homeRosterId        String
  homeRoster          DraftRoster      @relation("DraftHome", fields: [homeRosterId], references: [id], onDelete: Cascade)
  awayRosterId        String
  awayRoster          DraftRoster      @relation("DraftAway", fields: [awayRosterId], references: [id], onDelete: Cascade)
  homeScore           Int?
  awayScore           Int?
  status              DraftMatchStatus @default(SCHEDULED)
  scheduledAt         DateTime
  playedAt            DateTime?
  reportedByDiscordId String?
  createdAt           DateTime         @default(now())
  proofs              MatchProof[]

  @@unique([leagueId, round, homeRosterId])
  @@index([leagueId, round])
  @@index([leagueId, scheduledAt])
  @@index([leagueId, status])
}

model TransferOffer {
  id              String              @id @default(cuid())
  leagueId        String
  league          DraftLeague         @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  kind            TransferOfferKind
  playerId        String
  player          DraftPlayer         @relation(fields: [playerId], references: [id], onDelete: Cascade)
  fromRosterId    String
  fromRoster      DraftRoster         @relation("TransferFrom", fields: [fromRosterId], references: [id], onDelete: Cascade)
  toRosterId      String?
  toRoster        DraftRoster?        @relation("TransferTo", fields: [toRosterId], references: [id], onDelete: Cascade)
  offeredPlayerId String?
  price           Int                 @default(0)
  message         String?
  status          TransferOfferStatus @default(PENDING)
  respondedAt     DateTime?
  expiresAt       DateTime?
  createdAt       DateTime            @default(now())

  @@index([leagueId, status])
  @@index([toRosterId, status])
  @@index([fromRosterId, status])
}
