ENV_TYPE=DEVELOPMENT

DATABASE_URL="postgresql://login:password@localhost:5432/nameDatabase"
JWT_SECRET="your-jwt-secret"
RIOT_API_KEY="your-riot-api-key"

ADMIN_NAME="NameOfAdmin"
ADMIN_EMAIL="emailOfAdmin@gmail.com"
ADMIN_PASSWORD="passwordOfAdmin"
ADMIN_DISCORD_ID="discordIdOfAdmin"
PORT="3333"

# Discord Bot (necord) - needed only when DiscordBotModule is enabled
TOKEN_BOT="your-discord-bot-token"
# DISCORD_GUILD_ID is optional: set it in development for instant slash command registration
# in a specific server. Leave unset in production so commands register globally (all servers).
# DISCORD_GUILD_ID="your-guild-id-for-dev-commands"

# Segredo compartilhado para autenticação do bot (deve ser igual ao BOT_SECRET do bot)
BOT_SECRET="a-long-random-secret-string"

# Discord OAuth2
DISCORD_CLIENT_ID="your-discord-client-id"
DISCORD_CLIENT_SECRET="your-discord-client-secret"
DISCORD_REDIRECT_URI="http://localhost:3333/auth/discord/callback"
WEB_URL="http://localhost:3000"


# IA: uma chave por provedor, todas opcionais. O painel admin mostra quais
# existem nesta instância e só oferece essas.
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"
OPENAI_API_KEY="your-openai-api-key"
DEEPSEEK_API_KEY="your-deepseek-api-key"

# EA FC Clubs integration
EA_FC_TIMEOUT_MS="10000"
EA_FC_MAX_RETRIES="2"
EA_FC_REQUESTS_PER_SECOND="4"
EA_FC_MAX_RESULTS="100"
EA_FC_LEADERBOARD_MIN_APPEARANCES="3"
EA_FC_AUTO_SYNC_ENABLED="true"

# SFU (LiveKit) auto-hospedado. O caminho normal e configurar em /admin/live no
# painel, que salva no banco e nao exige redeploy. Estas variaveis existem como
# fallback: valem so quando nao ha nada salvo no painel.
# Suba o servidor com docker-compose.livekit.yml (veja docs/LIVEKIT.md).
# LIVEKIT_URL="wss://livekit.seudominio.com"
# LIVEKIT_API_KEY="timbas"
# LIVEKIT_API_SECRET="gere-com-openssl-rand-hex-32"

# Chave de criptografia das integracoes salvas pelo painel (tabela
# IntegrationSetting). Opcional: sem ela a chave e derivada do JWT_SECRET, o que
# ja liga a criptografia, mas amarra os segredos ao ciclo de vida do JWT.
# Aceita lista separada por virgula para rotacao: a primeira cifra, as demais so
# abrem o que foi cifrado antes. Os valores migram sozinhos para a chave nova na
# proxima leitura, entao a chave antiga so precisa ficar na lista por um deploy.
# Gere com: openssl rand -hex 32
# SETTINGS_ENCRYPTION_KEY="chave-nova-hex,chave-antiga-hex"
#
# Alternativa: apontar para um arquivo com o mesmo conteudo. Tem prioridade
# sobre a variavel acima e mantem a chave fora da lista de variaveis do painel,
# onde ela aparece em print de tela e em docker inspect. Monte o arquivo como
# somente leitura para o container.
# SETTINGS_ENCRYPTION_KEY_FILE="/run/secrets/settings.key"
